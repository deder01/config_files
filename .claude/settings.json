{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git ls-tree*)",
      "Bash(git remote*)",
      "Bash(git rev-parse*)",
      "Bash(git blame*)",
      "Bash(git config --get*)",
      "Bash(git config --list*)",
      "Bash(git add*)",
      "Bash(/usr/bin/git --git-dir=$HOME/.cfg/ --work-tree=$HOME add*)",
      "Bash(/usr/bin/git --git-dir=$HOME/.cfg/ --work-tree=$HOME status*)",
      "Bash(/usr/bin/git --git-dir=$HOME/.cfg/ --work-tree=$HOME log*)",
      "Bash(/usr/bin/git --git-dir=$HOME/.cfg/ --work-tree=$HOME diff*)",
      "Bash(/usr/bin/git --git-dir=$HOME/.cfg/ --work-tree=$HOME branch*)",
      "Bash(/usr/bin/git --git-dir=$HOME/.cfg/ --work-tree=$HOME show*)",
      "Bash(/usr/bin/git --git-dir=$HOME/.cfg/ --work-tree=$HOME ls-files*)",
      "Bash(/usr/bin/git --git-dir=$HOME/.cfg/ --work-tree=$HOME ls-tree*)",
      "Bash(ssh -T git@github.com*)",
      "Bash(ls*)",
      "Bash(which*)",
      "Bash(node*)",
      "Bash(npm list*)",
      "Bash(npm --version*)",
      "Bash(npx --version*)",
      "Bash(tsc --version*)",
      "Bash(pwd*)",
      "Bash(echo*)",
      "Bash(env*)",
      "Bash(printenv*)",
      "Bash(uname*)",
      "Bash(whoami*)",
      "Bash(hostname*)",
      "Bash(date*)",
      "Bash(wc*)",
      "Bash(cat*)",
      "Bash(gws auth status*)",
      "Bash(gws schema*)",
      "Bash(gws gmail users messages list*)",
      "Bash(gws gmail users messages get*)",
      "Bash(gws gmail users threads list*)",
      "Bash(gws gmail users threads get*)",
      "Bash(gws gmail users labels list*)",
      "Bash(gws gmail users labels get*)",
      "Bash(gws gmail users drafts list*)",
      "Bash(gws gmail users drafts get*)",
      "Bash(gws gmail +read*)",
      "Bash(gws gmail +triage*)",
      "Bash(gws drive files list*)",
      "Bash(gws drive files get*)",
      "Bash(gws sheets spreadsheets get*)",
      "Bash(gws sheets spreadsheets values get*)",
      "Bash(gws calendar events list*)",
      "Bash(gws calendar events get*)",
      "Bash(gws calendar calendars get*)",
      "Bash(gws calendar calendarList list*)",
      "Bash(gws calendar +agenda*)",
      "Bash(gws docs documents get*)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline/statusline.sh"
  },
  "model": "claude-opus-4-6",
  "effortLevel": "xhigh",
  "showClearContextOnPlanAccept": true,
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$HOME/.claude/hooks/gws-write-guard.sh\"" }
        ]
      }
    ]
  }
}
